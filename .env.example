# Start with mock agents; no key is required.
AGENT_PROVIDER=mock

# To use real, independent providers, install the matching extras and set keys:
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# PRODUCER_A_PROVIDER=anthropic
# PRODUCER_A_MODEL=claude-sonnet-4-6
# PRODUCER_B_PROVIDER=openai
# PRODUCER_B_MODEL=gpt-5-mini
# REVIEWER_PROVIDER=anthropic
# REVIEWER_MODEL=claude-sonnet-4-6

# Safety and cost boundaries
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_OUTPUT_CHARS=20000

